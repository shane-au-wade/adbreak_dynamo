{
    "name":"Adbreak Dynamo",
    "version": "0.1",
    "manifest_version": 2,
    "content_scripts": [
         {
            "matches": ["https://studio.youtube.com/video/*/monetization/ads"],
            "js": ["checkBoxes.js"],
            "run_at": "document_end"
         },
         {
            "matches": ["https://studio.youtube.com/channel/*/*"],
            "js": ["rowUpdate.js"],
            "run_at": "document_end"
         }
     ]
}