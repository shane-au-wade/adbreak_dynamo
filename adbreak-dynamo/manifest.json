{
    "name":"Adbreak Dynamo",
    "version": "0.1",
    "manifest_version": 2,
    "content_scripts": [
         {
            "matches": ["https://studio.youtube.com/video/*/monetization/ads"],
            "js": ["./monetization/routines/index.js"],
            "run_at": "document_end"
         },
         {
            "matches": ["https://studio.youtube.com/channel/*/*"],
            "js": ["./monetization/entryPoint.js"],
            "run_at": "document_start"
         },
         {
            "matches": ["https://studio.youtube.com/video/*/monetization/endpoint"],
            "js": ["./monetization/endPoint.js"],
            "run_at": "document_start"
         }
     ],
     "background": {
        "scripts": ["./background/index.js"]
     },
     "browser_action": {
         
     },
     "permissions": [
      "tabs", "storage", "http://localhost:3000/*", "http://localhost:3000/hello","http://localhost:3000/click", "http://localhost:3000/typevalue/*", "http://localhost:3000/robot/createAdbreaks/*"
   ]
}