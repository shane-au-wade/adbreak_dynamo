{
    "name":"Adbreak Dynamo",
    "version": "0.1",
    "manifest_version": 2,
    "content_scripts": [
         {
            "matches": ["https://studio.youtube.com/video/*/monetization/ads"],
            "js": ["monetizeNoAdbreaks.js"],
            "run_at": "document_end"
         },
         {
            "matches": ["https://studio.youtube.com/channel/*/*"],
            "js": ["entryPoint.js"],
            "run_at": "document_start"
         }
     ],
     "background": {
        "scripts": ["background.js"]
     },
     "browser_action": {
         
     },
     "permissions": [
      "tabs", "https://studio.youtube.com/s/e95c104c/creator_studio_mod_binary_core_v2.js", "http://localhost:3000/hello","http://localhost:3000/click", "http://localhost:3000/typevalue/*", "http://localhost:3000/robot/createAdbreaks/*"
   ]
}